{
    "name": "ifixit/php7-optional",
    "description": "Option and Either types for PHP: an alternative to null and to throwing",
    "license": "MIT",
    "authors": [
        {
            "name": "Jarred Stelfox",
            "email": "jarred@ifixit.com"
        }
    ],
    "require": {
      "php": "^8.4"
    },
    "autoload": {
      "psr-4": {
         "Optional\\": "src/"
      }
    },
    "autoload-dev": {
      "psr-4": {
        "Optional\\Tests\\": "tests/"
      }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "vimeo/psalm": "^6.0",
        "psalm/plugin-phpunit": "^0.19"
    }
}
