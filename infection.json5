{
    // Mutation testing: break the source on purpose and check a test notices.
    //
    // This is here because two adversarial reviews found untested behavior by
    // mutating by hand, such as which class Option::mapSafely catches. Each
    // case had a docblock and a line in AGENTS.md describing it, and nothing
    // that would fail if it were deleted. A green suite said nothing about any
    // of them.
    //
    // Needs xdebug or pcov, which CI has and a plain PHP install does not.
    //
    //     composer mutation
    //
    // Both thresholds are 100. Measured on PHP 8.5 with pcov, every mutant is
    // killed, so one that survives from now on fails the build. It means one of two things, both worth a look: a test is
    // missing, or the code it changed does nothing.
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "php://stdout"
    },
    "mutators": {
        "@default": true,
        // The (bool) in isFalsy() is for psalm, which reports ! on a mixed
        // value as RiskyTruthyFalsyComparison. Without it the expression means
        // the same, so no test can kill the mutant that removes it.
        "CastBool": {
            "ignore": ["Optional\\Option::isFalsy"]
        }
    },
    "minMsi": 100,
    "minCoveredMsi": 100,
    "testFramework": "phpunit"
}
