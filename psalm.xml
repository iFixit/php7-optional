<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    findUnusedBaselineEntry="true"
    findUnusedCode="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src"/>
        <directory name="tests"/>
        <directory name="bin"/>
        <ignoreFiles>
            <directory name="vendor"/>
            <!--
                @psalm-trace reports as an issue, so the type-assertion fixture
                cannot be in the main run. TypeInferenceTest analyses it on its
                own and compares the traces against recorded types.
            -->
            <directory name="tests/TypeInference"/>
        </ignoreFiles>
    </projectFiles>

    <plugins>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin"/>
    </plugins>

    <!--
        tests/generated/DocblockExamples.php holds every ```php example from src/
        and README.md, so psalm checks that the documentation type-checks and not
        just that it runs. A chaining method once demanded an impossible never
        type from its callback for years, and its own example was an
        InvalidArgument that nothing reported.

        The suppressions below are the ways an example is legitimately unlike
        production code, and nothing more. An example assigns $myVar to show a
        result and never reads it, echoes to show output, casts a box to string,
        and leaves closure types off for brevity.

        ReservedWord, NoValue and InvalidOperand have one shape: an example
        that shows nothing happens on the empty side calls a method on a box it
        just built empty, and psalm, correctly, types that callback's parameter
        as never. DocblockTypeContradiction is the same shape once more: an
        annotation good enough to prove the outcome makes the example
        demonstrating it look redundant.

        The first two once hid a real defect. When map() returned
        Option<U>|Option<never>, a second typed map() in a user's own code failed
        with ReservedWord, and these suppressions kept the examples quiet about
        it. tests/TypeInference/Expressions.php is where chained calls are
        checked, with nothing suppressed.

        Everything that catches a real defect stays on, which is
        UndefinedClass, UndefinedMethod, InvalidArgument, TooFewArguments and
        the rest of the default set.
    -->
    <issueHandlers>
        <UnusedVariable>
            <errorLevel type="suppress"><file name="tests/generated/DocblockExamples.php"/></errorLevel>
        </UnusedVariable>
        <UnusedClosureParam>
            <errorLevel type="suppress"><file name="tests/generated/DocblockExamples.php"/></errorLevel>
        </UnusedClosureParam>
        <MissingClosureReturnType>
            <errorLevel type="suppress"><file name="tests/generated/DocblockExamples.php"/></errorLevel>
        </MissingClosureReturnType>
        <InvalidCast>
            <errorLevel type="suppress"><file name="tests/generated/DocblockExamples.php"/></errorLevel>
        </InvalidCast>
        <ReservedWord>
            <errorLevel type="suppress"><file name="tests/generated/DocblockExamples.php"/></errorLevel>
        </ReservedWord>
        <InvalidOperand>
            <errorLevel type="suppress"><file name="tests/generated/DocblockExamples.php"/></errorLevel>
        </InvalidOperand>
        <PossiblyNullOperand>
            <errorLevel type="suppress"><file name="tests/generated/DocblockExamples.php"/></errorLevel>
        </PossiblyNullOperand>
        <NoValue>
            <errorLevel type="suppress"><file name="tests/generated/DocblockExamples.php"/></errorLevel>
        </NoValue>
        <DocblockTypeContradiction>
            <errorLevel type="suppress"><file name="tests/generated/DocblockExamples.php"/></errorLevel>
        </DocblockTypeContradiction>
    </issueHandlers>
</psalm>
