<?xml version="1.0"?>
<!--
    Runs the library's psalm plugin over its fixtures, for StaticAnalysisTest.
    One drops Results on purpose and the other traces types, so the main
    psalm.xml leaves both out.
-->
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    findUnusedCode="false"
    autoloader="../../vendor/autoload.php"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config ../../vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <file name="dropped-results.php"/>
        <file name="branch-built.php"/>
        <file name="wrong-type-count.php"/>
    </projectFiles>

    <plugins>
        <pluginClass class="Optional\StaticAnalysis\Psalm\Plugin"/>
    </plugins>
</psalm>
